<?xml version="1.0" encoding="utf-8" ?>
<!--
  הגדרות הלוג. זה המקור היחיד לכללי הלוג (appsettings.json לא מגדיר לוגים).
  הקוד ממשיך להשתמש ב-ILogger הרגיל של .NET, ו-NLog מתחבר מתחת.
  רמות: Debug לפיתוח · Information לזרימה רגילה · Warning לחריג שטופל · Error לכשל.
  אסור בלוג: סיסמאות, tokens, כותרת Authorization, גוף בקשות register/login.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- כל שורה: זמן | רמה | CorrelationId | מקור | הודעה (+ פרטי חריגה אם יש) -->
  <variable name="lineLayout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:item=CorrelationId:whenEmpty=-} | ${logger} | ${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <!-- קובץ מתגלגל לפי יום: library.log הוא היום, ימים קודמים נשמרים כ-library.yyyy-MM-dd.log, 14 ימים אחורה -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/library.log"
            archiveFileName="${basedir}/logs/library.{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            archiveEvery="Day"
            maxArchiveFiles="14"
            encoding="utf-8"
            layout="${lineLayout}" />

    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- הודעות העלייה והכיבוי של השרת (למשל "Now listening on") -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- מהמערכת (ASP.NET Core, EF Core): רק Warning ומעלה, כדי שכל שאילתת SQL לא תמלא את הקובץ -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- הקוד שלנו וכל השאר: Information ומעלה -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
